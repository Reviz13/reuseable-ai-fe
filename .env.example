# ai-service (only process that holds the service role key)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000
APP_ISSUERS={"pos":"http://localhost:4100/.well-known/jwks.json"}
POS_BASE_URL=http://localhost:4100
# same value as mock-pos INTERNAL_KEY
POS_INTERNAL_KEY=
ANTHROPIC_API_KEY=
# optional OpenAI-compatible fallback
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
WIDGET_DIR=../../packages/widget/dist
# studio (anon key only; reads SUPABASE_URL and SUPABASE_ANON_KEY at runtime, no NEXT_PUBLIC_ vars)
SUPABASE_ANON_KEY=
AI_SERVICE_URL=http://localhost:4000
# mock-pos
INTERNAL_KEY=
# demo + dev runner (root .env is loaded by `pnpm dev` via dotenv-cli)
# NOTE: POS_INTERNAL_KEY (ai-service) and INTERNAL_KEY (mock-pos) must be the same value
MOCK_POS_URL=http://localhost:4100
# set to 1 to allow /api/demo-token when NODE_ENV=production (it issues tokens to anyone)
DEMO_ENABLED=
# dev admin created by `pnpm seed:admin`, used by `pnpm seed:avatars` (placeholders, choose your own)
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=CHANGE_ME

# Task 15: `pnpm test:e2e` (against a running `pnpm dev`) runs the admin-upload spec only when both are set
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# `pnpm eval` admin token (uploads evals/knowledge, reads audit); falls back to SEED_ADMIN_EMAIL/PASSWORD
EVAL_ADMIN_EMAIL=
EVAL_ADMIN_PASSWORD=
# dev-only (Ruling 45; refused when NODE_ENV=production): LOCAL_MODE=1 runs ai-service on in-process PGlite,
# LLM_FAKE_SCRIPT=<json> replaces the LLM with a scripted fake. Leave empty for normal dev.
LOCAL_MODE=
LLM_FAKE_SCRIPT=
